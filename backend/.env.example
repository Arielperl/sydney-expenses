# Copy this file to .env and fill in the values you need. .env is gitignored —
# never commit real secrets. Every variable here maps 1:1 to a field in
# app/core/config.py:Settings; see that file for full defaults/docstrings.

# --- Environment ---
# "development" enables internal simulator endpoints; "production" blocks
# them outright regardless of any other setting.
# APP_ENVIRONMENT=development

# --- Database ---
# DATABASE_URL=sqlite:///./receiptly.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Uploads / CORS / currency ---
# UPLOADS_DIR=./uploads
# MAX_UPLOAD_SIZE_BYTES=10485760
# MAX_UPLOAD_PIXELS=25000000
# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# ALLOWED_HOSTS=["localhost","127.0.0.1"]
# DEFAULT_CURRENCY=ILS

# --- Customer document issuance: disabled (default) | mock ---
# Keep disabled outside local development until a real invoicing provider is
# connected. mock creates synthetic DEMO-* references and is rejected in prod.
DOCUMENT_PROVIDER=disabled

# --- Receipt extraction provider: mock (default) | local | openai ---
RECEIPT_EXTRACTOR_PROVIDER=mock

# --- OpenAI provider (only used when RECEIPT_EXTRACTOR_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_RECEIPT_MODEL=gpt-...
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=2

# --- Local provider: Ollama + Tesseract (only used when RECEIPT_EXTRACTOR_PROVIDER=local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# gemma3:12b is the current default (see README "Local model choice" for why —
# same measured accuracy as qwen3-vl:8b under this pipeline, ~2x faster);
# set to qwen3-vl:8b to use the other.
# OLLAMA_RECEIPT_MODEL=gemma3:12b
# OLLAMA_TIMEOUT_SECONDS=120
# OLLAMA_MAX_RETRIES=2
# Context window: a tall receipt photo + full prompt has been observed to need
# more than 8192 tokens. Larger uses more RAM/VRAM while the model is loaded.
# OLLAMA_NUM_CTX=16384
# Max output tokens. Sized against OLLAMA_TIMEOUT_SECONDS, not just picked
# generously: gemma3:12b generates at ~12 tokens/second on typical hardware, so
# a budget the model actually has to reach must still finish comfortably inside
# the timeout above, or a request that should fail cleanly (truncated output)
# instead always hits a slow network timeout first. 768 leaves real margin at
# that speed while still exceeding what any real successful extraction needs.
# OLLAMA_NUM_PREDICT=768
# Smaller ctx/predict budgets, used instead of the two above only when the
# deterministic OCR/spatial parser has already confidently resolved every
# factual field and the model is asked only for business_name/category. Context
# is kept equal to OLLAMA_NUM_CTX (never reduced) — reducing it was measured to
# make a "thinking"-style model hang for 180s+ instead of degrading gracefully.
# OLLAMA_NUM_CTX_FAST=16384
# OLLAMA_NUM_PREDICT_FAST=512
# Deterministic sampling: temperature=0 always picks the highest-probability
# token; a fixed seed makes that choice reproducible run-to-run on the same
# input. Both were previously left unset (each model's own Ollama default),
# a real source of run-to-run field-level variance on identical inputs.
# OLLAMA_TEMPERATURE=0.0
# OLLAMA_SEED=42
# TESSERACT_LANGUAGES=heb+eng

# --- Receipt image storage: local (default) | supabase ---
# STORAGE_PROVIDER=local
# STORAGE_PROVIDER=supabase requires all three of:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=receipts
# SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# --- Payment webhook ingestion (demo provider only, see
# backend/scripts/demo_webhook_request.py) ---
# Required to run the demo script against a live server. Never a real secret
# here — pick any local placeholder value for development.
# WEBHOOK_SIGNING_SECRET=demo-secret-change-me
# A dedicated random master key (32+ characters) for per-business connections.
# CONNECTION_SIGNING_SECRET=replace-with-a-long-random-secret
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# WEBHOOK_MAX_BODY_BYTES=65536

# --- Grow account-level webhook ingestion ---
# Grow's account-level (passive, webhook-only) integration has NO signing
# capability at all — webhookKey is confirmed by Grow not to be a secret and
# must never be treated as one. The connecting source IP is the only
# application-layer defense, enforced in production only (development never
# checks it, so local testing doesn't need to spoof a Grow IP). Production
# refuses to start with this unset — see app/core/config.py:validate_auth_settings.
# A plain JSON list of individual IPs and/or CIDR ranges — not a secret,
# safe to keep here. Current official list (verify against
# https://developers.grow.business/reference/ip-address before deploying —
# Grow may update it):
# GROW_WEBHOOK_ALLOWED_IPS=["3.123.194.128","3.124.62.248","18.198.97.252","3.75.43.49","18.156.94.176","18.158.107.17","3.121.149.170","3.76.166.104","3.69.160.29","3.78.79.166","3.71.221.153","3.78.131.18","3.67.110.47","18.192.112.151","52.59.95.229","18.158.145.146","3.75.128.58","3.78.28.179","3.122.21.187","3.66.126.119","35.158.249.118","52.29.70.254","52.59.159.234","3.76.183.119","18.157.106.67","18.197.238.68","3.66.129.154","3.77.123.153","3.70.40.72"]

# --- Automatic provider-document sync (Grow's "Invoice creation" webhook,
# Cardcom's GetLpResult DocumentInfo) ---
# How long a sale may sit at document_status=waiting_automatic before the
# Exception Center (and the Dashboard's "needs attention" count) treats it
# as needing attention instead of a normal, still-arriving delivery. Not a
# secret — optional, defaults to 24 if unset. See README's "Automatic
# provider documents" section.
# DOCUMENT_MATCH_GRACE_PERIOD_HOURS=24

# --- Cardcom account-level webhook ingestion ---
# Cardcom's own documentation requires calling Cardcom's own
# LowProfile/GetLpResult API server-to-server before trusting any webhook
# delivery — that verification call, not the source IP, is the primary
# authentication. This IP allowlist is defense-in-depth on top of it, not a
# substitute for it. Production refuses to start with this unset — see
# app/core/config.py:validate_auth_settings. Current official ranges (verify
# against Cardcom's own support docs before deploying — Cardcom may update
# them): 82.80.227.17/29 and 82.80.222.124/29.
# CARDCOM_WEBHOOK_ALLOWED_IPS=["82.80.227.17/29","82.80.222.124/29"]
# CARDCOM_API_BASE_URL=https://secure.cardcom.solutions
# CARDCOM_API_TIMEOUT_SECONDS=15
# A dedicated Fernet key (never reuse CONNECTION_SIGNING_SECRET or any other
# key here) used to encrypt each business's own real Cardcom terminal
# credentials (ApiName/ApiPassword, entered once when creating a Cardcom
# connection) at rest. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A leaked key here is a leaked set of real third-party payment credentials —
# treat it at least as seriously as SUPABASE_SECRET_KEY.
# CARDCOM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- CSV sales-export import ---
# CSV_MAX_FILE_SIZE_BYTES=2097152
# CSV_MAX_ROWS=2000
# Production requires a dedicated random value of at least 32 characters.
# CSV_PREVIEW_SIGNING_SECRET=replace-with-a-long-random-secret
# CSV_PREVIEW_TTL_SECONDS=900

# Public website / Supabase authentication (enabled by default).
# Keep these on the server. Never put SUPABASE_SECRET_KEY in VITE_* variables.
AUTH_REQUIRED=true
