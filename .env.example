# Backend configuration. Copy this file to backend/.env and adjust as needed.

# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./receiptly.db
# PostgreSQL/Supabase example (use the Session Pooler URI and keep the real value secret):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Directory where uploaded receipt images are stored locally.
UPLOADS_DIR=./uploads

# Maximum accepted upload size, in bytes (default: 10 MB).
MAX_UPLOAD_SIZE_BYTES=10485760

# Comma-separated list is not supported here; this is a single JSON-style list in code defaults.
# Origins allowed to call the API (the local frontend dev server).
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Default currency assigned to new expenses.
DEFAULT_CURRENCY=ILS

# Receipt extraction provider:
#   "mock"   (default, no API key needed, fully local and deterministic)
#   "local"  (fully local and free: Tesseract OCR + a local Ollama vision model —
#             never calls any external API, but needs Ollama running and a model
#             pulled first; see README's "Mock vs. local vs. real AI mode" section)
#   "openai" (sends the receipt image to OpenAI — see the same README section)
RECEIPT_EXTRACTOR_PROVIDER=mock

# Required only when RECEIPT_EXTRACTOR_PROVIDER=openai. Never commit a real value here —
# set it in your local backend/.env, which is gitignored.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=

# How long to wait for a single OpenAI request before treating it as a timeout, and how
# many additional attempts to make for transient failures (timeouts, connection errors,
# rate limits, 5xx) before giving up. Non-transient errors are never retried.
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Used only when RECEIPT_EXTRACTOR_PROVIDER=local. Ollama must already be running
# locally (`ollama serve`) with the model pulled (`ollama pull gemma3:12b`) — no
# key is needed since nothing leaves this machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RECEIPT_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2

# Tesseract language packs to use for the local provider's OCR pass. Requires the
# `heb` and `eng` language data to be installed alongside the `tesseract` binary.
TESSERACT_LANGUAGES=heb+eng

# Receipt image storage provider:
#   "local"    (default, no external credentials needed — stores images on disk
#               under UPLOADS_DIR, served back via this API's own /uploads route)
#   "supabase" (stores images in a private Supabase Storage bucket; the frontend
#               never receives the bucket's public URL or the service key — only a
#               freshly generated, time-limited signed URL per API response)
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=supabase. Never commit a real value here —
# set it in your local backend/.env, which is gitignored. Use the Supabase project's
# secret/service-role key (never the anon/public key) so it can read a private bucket.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# How long a generated signed URL stays valid, in seconds (default: 1 hour). A signed
# URL is never persisted — a fresh one is generated on every API response instead.
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
